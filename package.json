{
  "name": "polytypo-spec",
  "version": "0.0.0",
  "description": "polytypo: canonical spec, conformance fixtures, and promo site — not a published package.",
  "homepage": "https://polytypo.dev/",
  "bugs": {
    "url": "https://github.com/polytypo/polytypo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polytypo/polytypo.git"
  },
  "license": "MIT",
  "author": "Iurii Rogulia",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:docs": "npx tsx brand/tools/gen_examples.ts && prettier --write promo/examples.json && python3 brand/tools/gen_readmes.py && python3 brand/tools/build_promo.py",
    "gen:promo-bundle": "esbuild node_modules/polytypo/dist/index.js --bundle --format=iife --global-name=PolytypoBrowser --platform=browser --outfile=promo/vendor/polytypo.browser.js --minify",
    "gen:brandbook": "python3 brand/tools/build_brandbook.py",
    "gen:conformance": "node scripts/gen-conformance.mjs",
    "generate:all": "npm run gen:docs && npm run gen:promo-bundle && npm run gen:brandbook && npm run gen:conformance",
    "validate:spec": "node scripts/validate-spec.mjs",
    "test": "vitest run",
    "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
    "check:workflow-shell-safety": "node scripts/check-workflow-shell-safety.mjs",
    "test:readme-gen": "python3 brand/tools/test_gen_readmes.py",
    "test:font-acquisition": "python3 brand/tools/test_gen_svg.py",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "parse5": "^8.0.1",
    "polytypo": "^1.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
